{
  "repo_path": "/absolute/path/to/demo-repo",
  "base_branch": "main",
  "test_cmd": ["go", "test", "./...", "-json"],
  "test_format": "gotest-json",
  "lint_cmd": ["go", "vet", "./..."],
  "dependency_file": "go.mod",
  "report_dir": "./reports",
  "timeouts_seconds": {
    "tests": 120,
    "lint": 60,
    "audit": 30,
    "git": 60
  },
  "max_output_bytes": 8192,
  "osv_base_url": "https://api.osv.dev"
}
